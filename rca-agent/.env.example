# Copy this file to rca-agent/.env (gitignored) and fill in the real
# values. docker-compose.yml loads it via env_file for the rca-agent
# service. See rca-agent/README.md for how to obtain the Slack bot token
# and Anthropic API key.

# --- Observability (defaults already match this stack's Docker service
# names — only override if you changed docker-compose.yml) ---
# PROMETHEUS_URL=http://prometheus:9090
# ALERTMANAGER_URL=http://alertmanager:9093
# LOKI_URL=http://loki:3100
# TEMPO_URL=http://tempo:3200
# GRAFANA_URL=http://grafana:3000

# --- MySQL read-only account (see expense-mysql-v1/migrations/
# 005_rca_readonly_user.sql) ---
MYSQL_RCA_USERNAME=rca_agent
MYSQL_RCA_PASSWORD=rca_agent_devpass

# --- Slack (bot token, chat:write scope — NOT the alertmanager incoming
# webhook URL) ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0123456789

# --- GitHub (public repos — leave GITHUB_TOKEN unset unless you hit rate
# limits; if set, it must be a read-only/no-scope classic token) ---
# GITHUB_BACKEND_REPO=daws-90s/expense-backend-v1.2
# GITHUB_FRONTEND_REPO=daws-90s/expense-frontend-v1.2
# GITHUB_MYSQL_REPO=daws-90s/expense-mysql-v1
# GITHUB_TOKEN=

# --- LLM (Anthropic Messages API) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=sk-ant-your-key

# --- Guardrails ---
# RCA_MAX_INVESTIGATION_SECONDS=300
# MAX_TOOL_CALLS_PER_INVESTIGATION=50
# QUERY_TIMEOUT_SECONDS=10
# MAX_LOG_LINES=200
# MAX_TRACE_RESULTS=50
# LOG_LEVEL=INFO

# --- Manual trigger (POST /investigate, POST /ask) --- port 8080 is
# published to the host (docker-compose.yml); set this if that port is
# reachable beyond your own machine/Docker network, so a stranger can't
# spam your Slack channel and Anthropic bill. Leave unset on a
# locked-down security group.
# RCA_MANUAL_TRIGGER_TOKEN=

# Independent of the token above: caps how often POST /investigate and
# POST /ask can be called per caller, even by someone who has the token.
# RCA_MANUAL_TRIGGER_RATE_LIMIT=10
# RCA_MANUAL_TRIGGER_RATE_LIMIT_WINDOW_SECONDS=60

# --- Auto-remediation (opt-in; also requires ENABLE_AGENT_REMEDIATION=true
# on the backend service, see expense-backend-v1.2/.env.example) --- the
# agent's only write action beyond Slack. Already turned on for both
# services in ../docker-compose.yml for this POC; override here (or set
# RCA_AUTO_REMEDIATION_ENABLED=false in docker-compose.yml directly) to
# turn it back off. See app/investigation/remediation_policy.py for
# exactly when this fires — never LLM-decided, see that module's
# docstring.
# BACKEND_URL=http://backend:4000
# RCA_AUTO_REMEDIATION_ENABLED=true
# RCA_AUTO_REMEDIATION_MIN_CONFIDENCE=High
# RCA_AUTO_REMEDIATION_COOLDOWN_SECONDS=900

# --- Grafana dashboard discovery (app/grafana/discovery.py) --- read-only
# /api/search + /api/dashboards/uid/{uid}, used to attach a relevant
# dashboard link to each RCA instead of a hardcoded UID. Defaults match
# docker-compose.yml's GF_SECURITY_ADMIN_PASSWORD; update both if you
# change it there.
# GRAFANA_API_USER=admin
# GRAFANA_API_PASSWORD=admin
# RCA_GRAFANA_DISCOVERY_ENABLED=true
# GRAFANA_DASHBOARD_TAG=expense-tracker
